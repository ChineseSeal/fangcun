NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_FEATURE_FLAGS=

# Optional AI designer provider. Keep the API key server-only. When omitted or
# unavailable, /ai uses the deterministic local rule recommender.
OPENAI_AI_DESIGNER_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_AI_DESIGNER_MODEL=gpt-5.6-luna
OPENAI_AI_DESIGNER_TIMEOUT_MS=6000

# Optional account sync. Use the publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required only by server-side review and album-share routes. Never use
# NEXT_PUBLIC_ and never expose this key in browser code or logs. Reviewer
# access is granted in Supabase Auth app_metadata as { "gallery_reviewer": true }.
SUPABASE_SERVICE_ROLE_KEY=
