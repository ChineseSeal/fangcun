{
  "name": "@fangcun/glyph-tools",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./server": "./src/server-catalog.ts",
    "./preview": "./src/preview.ts",
    "./seed": "./src/seed-catalog.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:glyphs": "python3 scripts/import_fonts.py",
    "lint": "node -e \"console.log('glyph tools: lint covered by typecheck')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
